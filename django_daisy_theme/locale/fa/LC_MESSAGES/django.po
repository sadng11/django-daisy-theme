msgid "All of the following objects and their related items will be deleted from the database:"
msgstr "تمام موارد زیر و اقلام وابسته به آن‌ها از پایگاه داده حذف خواهند شد:"

msgid "All of the following related objects will also be deleted from the database:"
msgstr "تمام موارد وابسته زیر نیز از پایگاه داده حذف خواهند شد:"

msgid "Remove from sorting"
msgstr "حذف از مرتب‌سازی"

msgid "None available"
msgstr "موردی موجود نیست"

msgid "Disable password-based authentication"
msgstr "غیرفعال‌سازی احراز هویت با گذرواژه"

msgid "Enable password-based authentication"
msgstr "فعال‌سازی احراز هویت با گذرواژه"
