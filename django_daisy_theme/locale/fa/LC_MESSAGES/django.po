msgid "Please enter your old password, for security’s sake, and then enter your new password twice so we can verify you typed it in correctly."
msgstr "لطفاً برای حفظ امنیت ابتدا گذرواژه قدیمی خود را وارد کنید، سپس گذرواژه جدید را دو بار تکرار نمایید."

msgid "Please correct the error below."
msgstr "لطفاً خطای زیر را تصحیح کنید."

msgid "Please correct the errors below."
msgstr "لطفاً خطاهای زیر را تصحیح کنید."

msgid "Are you sure?"
msgstr "آیا مطمئن هستید؟"

msgid "Yes, I'm sure"
msgstr "بله، مطمئنم"

msgid "Cancel"
msgstr "انصراف"

msgid "Save"
msgstr "ذخیره"

msgid "Save and add another"
msgstr "ذخیره و افزودن یکی دیگر"

msgid "Save and continue editing"
msgstr "ذخیره و ادامه ویرایش"

msgid "Save as new"
msgstr "ذخیره به عنوان رکورد جدید"

msgid "Save and view"
msgstr "ذخیره و مشاهده"

msgid "Add"
msgstr "افزودن"

msgid "Added"
msgstr "افزوده شد"

msgid "Change"
msgstr "تغییر"

msgid "Changed"
msgstr "تغییر یافت"

msgid "Delete"
msgstr "حذف"

msgid "Delete?"
msgstr "حذف؟"

msgid "Deleted"
msgstr "حذف شد"

msgid "History"
msgstr "تاریخچه"

msgid "Date/time"
msgstr "تاریخ/زمان"

msgid "User"
msgstr "کاربر"

msgid "Close"
msgstr "بستن"

msgid "Required"
msgstr "الزامی"

msgid "You don’t have permission to view or edit anything."
