msgstr "خطای سرور"

msgid "There was an internal server error while processing your request. Please try again later."
msgstr "هنگام پردازش درخواست شما خطای داخلی رخ داد. لطفاً بعداً دوباره امتحان کنید."

msgid "Please enter your credentials to access the administration panel."
msgstr "لطفاً اطلاعات کاربری خود را برای ورود به پنل مدیریت وارد کنید."

msgid "Enter your username"
msgstr "نام کاربری خود را وارد کنید"

msgid "Username"
msgstr "نام کاربری"

msgid "Password"
msgstr "گذرواژه"

msgid "Log in"
msgstr "ورود"

msgid "Log out"
msgstr "خروج"

